APP_ENV=dev
# live = call providers (through cache); replay = cache only, no network
DEMO_MODE=live
AED_BLOCK_THRESHOLD=10000
QA_SAMPLE_RATE=0.10

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_MAIN=openai/gpt-oss-120b
GROQ_MODEL_LIGHT=openai/gpt-oss-20b
GROQ_MODEL_GUARD=meta-llama/llama-prompt-guard-2-86m
# Prompt Guard score at or above this counts as injection
GUARD_THRESHOLD=0.5
LLM_TIMEOUT_S=10

GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_PROVIDER_CHAIN=groq,gemini,ollama

DB_PATH=backend/data/gulf_horizon_mini.sqlite
# committed so replay works from a clean clone
CACHE_PATH=backend/data/llm_cache.json
CORS_ORIGINS=http://localhost:3000
