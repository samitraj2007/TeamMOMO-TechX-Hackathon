APP_ENV=dev
# live = call providers (through cache); replay = cache only, no network
DEMO_MODE=live
AED_BLOCK_THRESHOLD=10000
QA_SAMPLE_RATE=0.10

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_MAIN=openai/gpt-oss-120b
GROQ_MODEL_LIGHT=openai/gpt-oss-20b
GROQ_MODEL_GUARD=meta-llama/llama-prompt-guard-2-86m
# Prompt Guard score at or above this counts as injection
GUARD_THRESHOLD=0.5
LLM_TIMEOUT_S=10

# Backup investigator provider, tried only when the main model is rate-limited, times out or is unreachable.
# Any OpenAI-compatible endpoint, e.g. Gemini https://generativelanguage.googleapis.com/v1beta/openai/
# or Ollama http://localhost:11434/v1. Leave BACKUP_LLM_MODEL empty to disable.
BACKUP_LLM_NAME=backup
BACKUP_LLM_BASE_URL=
BACKUP_LLM_API_KEY=
BACKUP_LLM_MODEL=
# optional; sent as reasoning_effort when set
BACKUP_LLM_REASONING_EFFORT=

DB_PATH=backend/data/gulf_horizon_mini.sqlite
# committed so replay works from a clean clone
CACHE_PATH=backend/data/llm_cache.json
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
